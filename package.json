{
  "name": "primerides",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "node scripts/test-admin-layout-regression.mjs",
    "mobile:start": "npm run start --workspace=mobile",
    "mobile:check": "tsc --noEmit --project apps/mobile/tsconfig.json",
    "check:all": "tsc --noEmit && tsc --noEmit --project apps/mobile/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@sentry/nextjs": "^11.1.0",
    "@vercel/analytics": "^2.0.1",
    "argon2": "^0.45.1",
    "lucide-react": "^1.39.0",
    "motion-icons-react": "^1.1.0",
    "next": "16.3.8",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
